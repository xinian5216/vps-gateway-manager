#!/usr/bin/env bash
# =============================================================================
# test stub :: curl
#
# Deterministic HTTP responses for the unit tests. Rules live in
# $STUB_STATE/curl/rules as "<url-substring><TAB><http-code>" (first match wins).
# Default code is 000 (connection failure).
#
# Only the flags this project uses are emulated:
#   -s -S -o FILE -w '...' -x/--proxy URL --resolve HOST:PORT:ADDR
#   --max-time N --connect-timeout N -r RANGE -L --proxy-cacert FILE
#   --interface ADDR -4 -6
#
# Address-family forcing (-4/-6) uses $CURL/rules-4 / $CURL/rules-6 when present,
# so tests can make the two families behave differently (dual-stack diagnostics).
#
# File downloads (-o) can serve real content through $CURL/files as
# "<url-substring><TAB><source-file>" (used by the install.sh bootstrap tests
# to serve real toolkit tarballs).
#
# Candidate probes (--resolve pins the upstream peer) are emulated with REAL
# curl semantics - exit code, %{http_connect}, %{http_code} and stderr - driven
# by $STUB_STATE/curl/probe-rules as "<addr><TAB><verdict>":
#   good                rc=0  connect=200 final=200
#   cert-name           rc=60 connect=000 final=000  (hostname mismatch)
#   cert-selfsigned     rc=60 connect=000 final=000  (untrusted issuer)
#   cert-expired        rc=60 connect=000 final=000  (expired certificate)
#   dead                rc=7  connect=000 final=000  (connection refused)
#   timeout             rc=28 connect=000 final=000
#   refused             rc=56 connect=403 final=000  (CONNECT denied)
#   unexpected-connect  rc=56 connect=500 final=000
#   unexpected-http     rc=0  connect=200 final=404
# A candidate without a rule is healthy (good).
# =============================================================================
set -uo pipefail

: "${STUB_STATE:?STUB_STATE must be set}"
CURL="$STUB_STATE/curl"
mkdir -p "$CURL" 2>/dev/null || true
printf '%s\n' "$*" >> "$CURL/calls.log"

# -w rendering like real curl: substitute the well-known variables.
# NOTE: the braces of %{http_connect}/%{http_code} must be escaped in a bash
# ${var//pattern/repl} pattern - unescaped, bash ends the pattern at the first
# `}` and silently mangles the output (verified by experiment).
render_write() {
  local fmt="$1" conn="$2" code="$3" final="" redir=""
  fmt="${fmt//%\{http_connect\}/$conn}"
  fmt="${fmt//%\{http_code\}/$code}"
  if printf '%s' "$fmt" | grep -q 'url_effective'; then
    final="$url"
    if [ -r "$CURL/redirects" ]; then
      redir="$(awk -F'\t' -v u="$url" '$0 !~ /^#/ && index(u, $1) > 0 { print $2; exit }' "$CURL/redirects")"
      [ -n "$redir" ] && final="$redir"
    fi
    fmt="${fmt//%\{url_effective\}/$final}"
  fi
  printf '%s' "$fmt"
}

url=""
outfile=""
write_fmt=""
proxy=""
family=""
resolve=""
interface=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) outfile="${2:-}"; shift 2 ;;
    -w) write_fmt="${2:-}"; shift 2 ;;
    -x|--proxy) proxy="${2:-}"; shift 2 ;;
    --resolve) resolve="${2:-}"; shift 2 ;;
    --interface) interface="${2:-}"; shift 2 ;;
    --proxy-cacert|--max-time|--retry|--connect-timeout|-r|--range|--max-filesize|--cacert|-H|-X) shift 2 ;;
    -4) family=4; shift ;;
    -6) family=6; shift ;;
    -s|-S|-fsSL|-fsS|-f|-L|-IL|-sS) shift ;;
    http*://*) url="$1"; shift ;;
    *) shift ;;
  esac
done

# Forced result for the unknown-source probe (--interface). Format:
#   <exit-code><TAB><raw write-out>
# The write-out is emitted verbatim, so tests can serve 000, empty, 200 or
# a malformed token and an exit code independent of it.
if [ -n "$interface" ] && [ -r "$CURL/interface-result" ]; then
  _irc="$(awk -F'\t' 'NR==1 { print $1; exit }' "$CURL/interface-result")"
  _iout="$(awk -F'\t' 'NR==1 { print $2; exit }' "$CURL/interface-result")"
  [ -n "$write_fmt" ] && printf '%s' "$_iout"
  exit "${_irc:-0}"
fi

if [ -f "$CURL/fail" ]; then
  [ -n "$write_fmt" ] && render_write "$write_fmt" 000 000
  printf 'curl: (7) Failed to connect to %s port 443: Connection refused\n' "$url" >&2
  exit 7
fi

# Forced failure for matching requests only:
# "$CURL/fail-with" = "<url-substring><TAB><exit-code><TAB><stderr-message>"
# An empty substring matches every request. Used to simulate TLS failures,
# interrupted transfers and gateway CONNECT refusals precisely where they
# belong in a multi-request flow.
if [ -r "$CURL/fail-with" ]; then
  _fwline="$(awk -F'\t' -v u="$url" '$0 !~ /^#/ && ($1 == "" || index(u, $1) > 0) { print; exit }' "$CURL/fail-with")"
  if [ -n "$_fwline" ]; then
    _fwrc="$(printf '%s\n' "$_fwline" | cut -f2)"
    _fwmsg="$(printf '%s\n' "$_fwline" | cut -f3)"
    [ -n "$write_fmt" ] && render_write "$write_fmt" 000 000
    [ -n "$_fwmsg" ] && printf '%s\n' "$_fwmsg" >&2
    exit "${_fwrc:-7}"
  fi
fi

# --- archive downloads (bootstrap tests) -------------------------------------
# "$CURL/files" = "<url-substring><TAB><source-file>": the source file becomes
# the -o output, so tests can serve real tarballs. A rule whose source is
# missing behaves like a real 404.
if [ -n "$outfile" ] && [ -r "$CURL/files" ]; then
  _src="$(awk -F'\t' -v u="$url" '$0 !~ /^#/ && index(u, $1) > 0 { print $2; exit }' "$CURL/files")"
  if [ -n "$_src" ]; then
    if [ -r "$_src" ]; then
      cp "$_src" "$outfile"
      [ -n "$write_fmt" ] && render_write "$write_fmt" 000 200
      exit 0
    fi
    [ -n "$write_fmt" ] && render_write "$write_fmt" 000 000
    printf 'curl: (22) The requested URL returned error: 404\n' >&2
    exit 22
  fi
fi

# --- candidate probe semantics (--resolve pins the peer) ---------------------
if [ -n "$resolve" ]; then
  cand="${resolve#*:*:}"
  cand="${cand//[\[\]]/}"
  verdict=""
  if [ -r "$CURL/probe-rules" ]; then
    verdict="$(awk -F'\t' -v c="$cand" '$0 !~ /^#/ && $1 == c { print $2; exit }' "$CURL/probe-rules")"
  fi
  [ -n "$verdict" ] || verdict="good"
  conn=200; code=200; rc=0; err=""
  case "$verdict" in
    good)               conn=200; code=200; rc=0 ;;
    cert-name)          conn=000; code=000; rc=60
                        err="curl: (60) SSL: no alternative certificate subject name matches target host name" ;;
    cert-selfsigned)    conn=000; code=000; rc=60
                        err="curl: (60) SSL certificate problem: self-signed certificate" ;;
    cert-expired)       conn=000; code=000; rc=60
                        err="curl: (60) SSL certificate problem: certificate has expired" ;;
    dead)               conn=000; code=000; rc=7
                        err="curl: (7) Failed to connect to $cand port 1 after 0 ms: Connection refused" ;;
    timeout)            conn=000; code=000; rc=28
                        err="curl: (28) Connection timed out after 10001 milliseconds" ;;
    refused)            conn=403; code=000; rc=56
                        err="curl: (56) CONNECT tunnel failed, response 403" ;;
    unexpected-connect) conn=500; code=000; rc=56
                        err="curl: (56) CONNECT tunnel failed, response 500" ;;
    unexpected-http)    conn=200; code=404; rc=0 ;;
    *)                  conn=000; code=000; rc=7
                        err="curl: (7) unknown probe verdict '$verdict'" ;;
  esac
  [ -n "$write_fmt" ] && render_write "$write_fmt" "$conn" "$code"
  [ -n "$err" ] && printf '%s\n' "$err" >&2
  exit "$rc"
fi

rules="$CURL/rules"
if [ -n "$family" ] && [ -f "$CURL/rules-$family" ]; then rules="$CURL/rules-$family"; fi

code=""
if [ -n "$url" ] && [ -f "$rules" ]; then
  code="$(awk -v u="$url" -F'\t' '$0 !~ /^#/ && index(u, $1) > 0 { print $2; exit }' "$rules")"
fi
[ -n "$code" ] || code="000"

# Emulate Squid's access log so routing decisions can be asserted in tests.
# $CURL/accesslog holds the path of the log to append to.
if [ -f "$CURL/accesslog" ] && [ -n "$url" ]; then
  alog="$(head -n1 "$CURL/accesslog")"
  host="$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#^[^/@]*@##; s#[:/].*$##')"
  # A request that produced no status never went anywhere (real Squid logs
  # HIER_NONE/- with NONE_NONE/000 - exactly the London failure signature).
  if [ "${code:-000}" = "000" ]; then
    hier="HIER_NONE/-"
    status="NONE_NONE/000"
  elif printf '%s' "$host" | grep -qE '(^|\.)github\.com$|(^|\.)githubusercontent\.com$|(^|\.)githubassets\.com$|^ghcr\.io$|(^|\.)github\.io$'; then
    hier="FIRSTUP_PARENT/gsp_upstream"
    status="TCP_MISS/${code}"
  else
    hier="HIER_DIRECT/93.184.216.34"
    status="TCP_MISS/${code}"
  fi
  printf '1699999999.000    %7s 127.0.0.1 %s 1234 CONNECT %s:443 - %s -\n' \
    "$((RANDOM % 400 + 50))" "$status" "$host" "$hier" >> "$alog" 2>/dev/null || true
fi

# A denied request is what proves the destination ACL works.
if [ "$code" = "403" ] && [ -n "$outfile" ] && [ "$outfile" != "/dev/null" ]; then
  printf '<html><body><h1>403 Forbidden</h1></body></html>\n' > "$outfile"
fi
if [ -n "$outfile" ] && [ "$outfile" != "/dev/null" ] && [ "$code" = "200" ]; then
  if printf '%s' "$url" | grep -q 'releases/latest'; then
    cp "$CURL/release.json" "$outfile"
  else
    printf 'stub payload for %s\n' "$url" > "$outfile"
  fi
fi

if [ -n "$write_fmt" ]; then
  render_write "$write_fmt" 000 "$code"
else
  if [ "$code" = "200" ] && [ -z "$outfile" ]; then
    printf 'stub payload for %s\n' "$url"
  fi
fi

case "$code" in
  2*|3*) exit 0 ;;
  4*|5*) exit 0 ;;
  *) exit 7 ;;
esac
